# Copia este archivo a .env.local y rellena los valores.

# Contraseña del panel de la agencia (/admin). En desarrollo, si falta, es "admin".
ADMIN_PASSWORD=
# Cadena larga y aleatoria para firmar las sesiones. Obligatoria en producción.
SESSION_SECRET=

# Postgres de Supabase (cadena del "Transaction pooler"). Sin ella, en local se
# usa una base embebida en .data/ que no requiere ninguna cuenta.
DATABASE_URL=

# Pass Studio (tarjetas de Apple/Google Wallet para la demo). Opcional.
PASS_STUDIO_API_KEY=
# PASS_STUDIO_BASE_URL=https://www.passstudio.online/api/v1
